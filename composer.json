{
    "name": "codeigniter4/appstarter",
    "description": "MCS (Moja Czysta Sieć): zbieranie zgłoszeń nadużyć i listingów reputacji dla własnych prefiksów ISP.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/kyob/MCS",
    "support": {
        "issues": "https://github.com/kyob/MCS/issues",
        "source": "https://github.com/kyob/MCS"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "McsPluginy\\": "plugins/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
