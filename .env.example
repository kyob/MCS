CI_ENVIRONMENT = production
app.baseURL = 'http://192.0.2.110/'
database.default.hostname = 127.0.0.1
database.default.database = mcs
database.default.username = mcs
database.default.password = 'ZMIEN'
database.default.DBDriver = Postgre
database.default.DBPrefix = ''
database.default.port = 5432
database.default.schema = public
database.default.charset = utf8
# MCS — API badge (LMS→MCS)
mcs.badgeToken = 'ZMIEN_TOKEN'

# --- Faza 1b: IMAP / SNDS per źródło (osobne konta; nie commituj prawdziwych haseł) ---
# Wymaga IMAP: apt install php8.4-imap (Sury na Trixie) + restart php-fpm/cli
# Patrz: docs/09-imap-konfiguracja-env.md

# Shadowserver
mcs.shadowserver.imapHost = ''
mcs.shadowserver.imapPort = 993
mcs.shadowserver.imapUser = ''
mcs.shadowserver.imapPass = ''
mcs.shadowserver.imapMailbox = 'INBOX'
mcs.shadowserver.imapEncryption = 'ssl'
# Dev/smoke bez IMAP: ustaw ścieżkę CSV. Live IMAP: zostaw puste (albo usuń linię).
mcs.shadowserver.fixturePath = ''
# przykład: '/var/www/mcs/tests/_support/fixtures/shadowserver_sample.csv'

# Play scrubbing (OSOBNA skrzynka)
mcs.play.imapHost = ''
mcs.play.imapPort = 993
mcs.play.imapUser = ''
mcs.play.imapPass = ''
mcs.play.imapMailbox = 'INBOX'
mcs.play.imapEncryption = 'ssl'
mcs.play.fixturePath = ''

# SNDS — zwykle bez IMAP (API / plik)
mcs.snds.dataUrl = ''
mcs.snds.apiKey = ''
mcs.snds.fixturePath = ''
