CI_ENVIRONMENT = production
app.baseURL = 'https://mcs.alfa-system.net/'
database.default.hostname = 127.0.0.1
database.default.database = mcs
database.default.username = mcs
database.default.password = 'ZMIEN'
database.default.DBDriver = Postgre
database.default.DBPrefix = ''
database.default.port = 5432
database.default.schema = public
database.default.charset = utf8
# MCS - API badge (LMS->MCS)
mcs.badgeToken = 'ZMIEN_TOKEN'

# --- Faza 1b: IMAP / SNDS per zrodlo (osobne konta; nie commituj prawdziwych hasel) ---
# Wymaga IMAP: apt install php8.4-imap (Sury na Trixie) + restart php-fpm/cli
# Patrz: docs/09-imap-konfiguracja-env.md

# Shadowserver (oficjalnie: imap.alfa-system.pl:993 SSL/TLS — poczta.alfa-system.pl/konfiguracja.html)
mcs.shadowserver.imapHost = ''
mcs.shadowserver.imapPort = 993
mcs.shadowserver.imapUser = ''
mcs.shadowserver.imapPass = ''
mcs.shadowserver.imapMailbox = 'INBOX'
mcs.shadowserver.imapEncryption = 'ssl'
# Gdy INBOX caly SEEN: ile ostatnich UID przetworzyc (checksum chroni przed duplikatem)
mcs.shadowserver.imapRecentLimit = 40
# Dev/smoke bez IMAP: ustaw sciezke CSV. Live IMAP: zostaw puste (albo usun linie).
mcs.shadowserver.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/shadowserver_sample.csv'

# Play scrubbing (OSOBNA skrzynka)
mcs.play.imapHost = ''
mcs.play.imapPort = 993
mcs.play.imapUser = ''
mcs.play.imapPass = ''
mcs.play.imapMailbox = 'INBOX'
mcs.play.imapEncryption = 'ssl'
mcs.play.imapRecentLimit = 100
mcs.play.fixturePath = ''

# SNDS - Microsoft Automated Data Access (jak LMS snds.key). Bez IMAP.
# key: UUID z portalu Auto (wygasa ~30 dni). Można też: Wtyczki → SNDS → Klucz (override w DB).
# lookbackDays: domyslnie 3 (wczoraj..).
mcs.snds.key = ''
mcs.snds.dataUrlTemplate = ''
# pusty template = substrate DataKey; useLegacyUrl=1 = stary host outlook
mcs.snds.useLegacyUrl = '0'
mcs.snds.lookbackDays = 3
# Dev/smoke: lokalny CSV (DataKey 13/14 kolumn lub z naglowkami). Live: zostaw puste.
mcs.snds.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/snds_datakey_sample.csv'

# MojeCert (moje.cert.pl) — REST Token; bez IMAP.
mcs.mojecert.baseUrl = 'https://moje.cert.pl'
mcs.mojecert.apiToken = ''
mcs.mojecert.syncDaysBack = 14
mcs.mojecert.syncMaxPagesPerSubnet = 100
mcs.mojecert.tlsSkipVerify = false
# Dev/smoke: lokalny JSON skanow. Live API: zostaw puste.
mcs.mojecert.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/mojecert_scan_sample.json'

# CERT N6 (n6api.cert.pl) — REST report/inside; Bearer i/lub mTLS. Bez IMAP.
mcs.cert_n6.baseUrl = 'https://n6api.cert.pl'
mcs.cert_n6.reportResource = 'report/inside'
mcs.cert_n6.bearerToken = ''
# opcjonalnie zamiast bearerToken: sciezka do pliku z tokenem (jak LMS cert/api.key)
mcs.cert_n6.apiKeyFile = ''
mcs.cert_n6.clientCertFile = ''
mcs.cert_n6.clientKeyFile = ''
mcs.cert_n6.clientCertPassword = ''
mcs.cert_n6.forceClientCert = false
mcs.cert_n6.tlsVerifyPeer = true
mcs.cert_n6.caFile = ''
# pierwsze uruchomienie bez state: jawny time.min albo lookbackDays (domyslnie 90)
mcs.cert_n6.timeMin = ''
mcs.cert_n6.lookbackDays = 90
mcs.cert_n6.stateFile = ''
# pusty = writable/cert_n6_state.json
mcs.cert_n6.optLimit = ''
mcs.cert_n6.modifiedMin = ''
# Dev/smoke: lokalny JSON tablicy zdarzen. Live API: zostaw puste.
mcs.cert_n6.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/cert_n6_report_inside_sample.json'

# Wanguard — REST anomalies Finished; HTTP Basic Auth. Bez IMAP.
# apiUrl musi konczyc sie na /wanguard-api/v1/ (ew. z /anomalies?... — normalizowane).
mcs.wanguard.apiUrl = 'https://wanguard.example/wanguard-api/v1/'
mcs.wanguard.apiUser = ''
mcs.wanguard.apiPassword = ''
mcs.wanguard.apiListLimit = 500
mcs.wanguard.concurrency = 15
mcs.wanguard.tlsVerifyPeer = true
# opcjonalny filtr CIDR (przecinek/spacja); pusty = wszystkie IP z prefix
mcs.wanguard.cidrAllowlist = ''
# Dev/smoke: lokalny JSON tablicy detaili. Live API: zostaw puste.
mcs.wanguard.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/wanguard_anomalies_sample.json'

# Cloudflare DDoS Botnet Threat Feed — Bearer; AS-scoped (PeeringDB).
# Docs: https://developers.cloudflare.com/ddos-protection/botnet-threat-feed/
# Token z uprawnieniem „DDoS Botnet Feed > Read”; nigdy nie commituj wartosci.
mcs.cloudflare_botnet.apiToken = ''
mcs.cloudflare_botnet.accountId = ''
# pusty accountId = auto z GET /accounts (pierwsze konto)
mcs.cloudflare_botnet.asn = '198050'
# full_report (ok. 2 tyg.) albo day_report
mcs.cloudflare_botnet.mode = 'full_report'
# opcjonalnie dla day_report: YYYY-MM-DD (puste = wczoraj wg CF)
mcs.cloudflare_botnet.date = ''
mcs.cloudflare_botnet.baseUrl = 'https://api.cloudflare.com/client/v4'
mcs.cloudflare_botnet.tlsVerifyPeer = true
# opcjonalny filtr CIDR (przecinek/spacja); pusty = wszystkie IP z feedu ASN
mcs.cloudflare_botnet.cidrAllowlist = ''
# Dev/smoke: lokalny JSON (result[] albo sama tablica). Live: zostaw puste.
mcs.cloudflare_botnet.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/cloudflare_botnet_sample.json'

# Qrator Radar — BGP / sieć (ASN), nie klasyczny stream IP.
# Klucz API z konta https://radar.qrator.net (nagłówek QRADAR-API-KEY).
# OpenAPI: https://api.radar.qrator.net/openapi.json
# Live bez klucza nie zadziała (HTTP 401). Nigdy nie commituj wartosci.
mcs.qrator.apiKey = ''
mcs.qrator.asn = '198050'
# Wersja IP dla feedów v2: 4 | 6 | all
mcs.qrator.ipVersion = 'all'
# Domyslne feedy: hijacks_affected,hijacks_created,leaks_created,leaks_accepted
# Opcjonalnie: amplifiers, bogons_created (amplifiers moga wymagac uprawnien AS owner)
mcs.qrator.feeds = ''
mcs.qrator.withArchive = false
mcs.qrator.baseUrl = 'https://api.radar.qrator.net'
mcs.qrator.tlsVerifyPeer = true
# Dev/smoke: lokalny JSON (events[] albo klucze feedow). Live: zostaw puste.
mcs.qrator.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/qrator_sample.json'

# CAIDA Spoofer — pomiary BCP38 (czy ASN przepuszcza spoofing). Publiczne API, bez klucza.
# Docs: https://www.caida.org/projects/spoofer/data-api/
# Import tylko sesji podanego ASN (osobno IPv4/IPv6). Prefiksy, nie pojedyncze IP.
mcs.spoofer.asn = '198050'
mcs.spoofer.baseUrl = 'https://api.spoofer.caida.org'
mcs.spoofer.tlsVerifyPeer = true
# opcjonalnie: tylko sesje nowsze niż N dni (puste = cała historia ASN; AS198050 ~ 3 strony)
mcs.spoofer.lookbackDays = ''
# Dev/smoke: lokalny JSON (hydra:member albo tablica sesji). Live: zostaw puste.
mcs.spoofer.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/spoofer_sample.json'

# --- AS198050 (Alfa-System) — matchowanie „naszych IP” ---
# Główna konfiguracja: /admin/ustawienia (tabela mcs_ustawienia).
# Poniższe klucze to tylko fallback, gdy brak wierszy w DB (np. przed migracją).
# mcs.as198050.wlaczone = true
# mcs.as198050.cidry = '91.231.80.0/22,176.97.24.0/21,2a0f:1700::/29'

# Reverse DNS (PTR) — przełącznik UI: /admin/ustawienia (klucz pokazuj_rev_dns, domyślnie off).
# mcs.revDns.cacheTtl = 3600

# --- Faza 3: enrichment AbuseIPDB (NIE wchodzi do mcs:pobierz / badge stream) ---
# Klucz z https://www.abuseipdb.com/account/api — tylko w .env, nigdy w gicie.
mcs.abuseipdb.apiKey = ''
mcs.abuseipdb.baseUrl = 'https://api.abuseipdb.com/api/v2'
mcs.abuseipdb.maxAgeInDays = 90
mcs.abuseipdb.cacheTtl = 86400
mcs.abuseipdb.verbose = true
# Dev/smoke bez klucza: lokalny JSON odpowiedzi /check. Live: zostaw puste.
mcs.abuseipdb.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/abuseipdb_check_sample.json'

# --- Mapowanie LMS: IP → komputer (node) + abonent (customer) ---
# Preferuj HTTP API (scaffold LMSMcsMapowaniePlugin) — bez otwierania DB LMS na świat.
# Token w [mcs] map_token w lms.ini MUSI być identyczny. Nigdy nie commituj wartości.
#
# Hosty LMS (mapowanie ≠ badge):
#   DEV/TEST mapowanie = 192.0.2.60  ← domyślny target testów
#   PROD LMS / badge   = 192.0.2.50  ← tylko gdy użytkownik wyraźnie powie
mcs.lms.baseUrl = ''
# przyklad (TEST): 'http://192.0.2.60'
mcs.lms.mapToken = ''
mcs.lms.apiPath = 'plugins/LMSMcsMapowaniePlugin/api.php'
mcs.lms.httpTimeout = 60
mcs.lms.tlsVerifyPeer = true
mcs.lms.cacheTtl = 86400
# Deep link do karty hosta w LMS (opcjonalnie):
mcs.lms.nodeUrlTemplate = ''
# przyklad (TEST): 'http://192.0.2.60/?m=nodeinfo&id={id}'
# Opcjonalny bezpośredni odczyt PostgreSQL LMS (gdy firewall pozwala; read-only user):
mcs.lms.dbHostname = ''
mcs.lms.dbPort = 5432
mcs.lms.dbDatabase = ''
mcs.lms.dbUsername = ''
mcs.lms.dbPassword = ''
mcs.lms.dbSslmode = prefer
# Dev/smoke: lokalny JSON items[]. Live: zostaw puste.
mcs.lms.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/lms_mapowanie_sample.json'

# isMalicious (https://ismalicious.com) — enrichment IP; auth base64(apiKey:apiSecret)
mcs.ismalicious.apiKey = ''
mcs.ismalicious.apiSecret = ''
mcs.ismalicious.apiCredential = ''
mcs.ismalicious.baseUrl = 'https://api.ismalicious.com'
mcs.ismalicious.enrichment = 'standard'
mcs.ismalicious.cacheTtl = 86400
mcs.ismalicious.fixturePath = ''

# SpamRats DNSBL RATS-All (https://www.spamrats.com/lists.php) — enrichment IPv4; poza badge.
# Zapytanie: {odwrócone-IP}.{apiKey}.all.spamrats.com (kody 127.0.0.36/37/38/43).
# Resolver MCS powinien mieć PTR; SpamRats blokuje open resolvery. Tylko w .env — nigdy w gicie.
mcs.spamrats.apiKey = ''
mcs.spamrats.zone = 'all.spamrats.com'
mcs.spamrats.cacheTtl = 86400
mcs.spamrats.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/spamrats_check_sample.json'
mcs.spamrats.smokeIp = '127.0.0.36'

# DNSBL multi (plugin dnsbl) — skan AS: UCEPROTECT + SpamCop + DroneBL; Spamhaus DQS opcjonalnie (klucz komercyjny).
# Listy i skany LMS/AS regulujesz też w WWW: /admin/ustawienia/opcje (grupa DNSBL).
# Codziennie: IP z LMS ∩ AS198050. Raz w tygodniu (asScanWeekday, 0=nd UTC): pełne IPv4 AS.
# Format zones: id=host,id=host (hosty; włączanie list = opcje WWW)
mcs.dnsbl.zones = 'uceprotect1=dnsbl-1.uceprotect.net,spamcop=bl.spamcop.net,dronebl=dnsbl.dronebl.org'
mcs.dnsbl.spamhausDqsKey = ''
# mcs.dnsbl.listaUceprotect / listaSpamcop / listaDronebl / listaSpamhaus / skanLms / skanAs / forceZakres / asScanWeekday
# — preferuj edycję w /admin/ustawienia/opcje (nadpisują .env)
mcs.dnsbl.asScanWeekday = 0
mcs.dnsbl.rateLimitQps = 25
mcs.dnsbl.cacheTtl = 86400
mcs.dnsbl.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/dnsbl_check_sample.json'
# mcs.dnsbl.forceZakres = auto   # auto|lms|as

# Speedtest Servers reporting (account.ookla.com/servers/reports) — enrichment, poza badge.
# Preferowane: login Ookla (Auth0) → automatyczny CSV z /api/servers/reports?format=csv.
# Fallback: ręczny eksport CSV do csvDir. Priorytet: fixturePath > email+password > csvDir.
mcs.speedtest.email = ''
mcs.speedtest.password = ''
mcs.speedtest.csvDir = ''
# przyklad: '/var/www/mcs/writable/speedtest-inbox'
mcs.speedtest.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/speedtest_sample.csv'

#--------------------------------------------------------------------
# Wazuh (plugin wazuh) — eksport przez SSH forced command, docs/11-plan-zrodlo-wazuh.md
#--------------------------------------------------------------------
mcs.wazuh.sshHost = 192.0.2.155
mcs.wazuh.sshUser = mcs-export
mcs.wazuh.sshKey = /etc/mcs/ssh/wazuh_ed25519
mcs.wazuh.knownHosts = /etc/mcs/ssh/known_hosts
mcs.wazuh.oknoGodzin = 48
mcs.wazuh.minZdarzen = 5
mcs.wazuh.progHigh = 5
mcs.wazuh.fixturePath = 

#--------------------------------------------------------------------
# Opcje strojenia (app/Libraries/OpcjeMcs.php) — edytowalne też w WWW: /admin/ustawienia/opcje
# Kolejność: wartość z WWW (mcs_ustawienia) → .env → domyślna (poniżej). Odkomentuj tylko, gdy zmieniasz.
# Także istniejące klucze liczbowe wyżej (cacheTtl, lookbackDays, imapRecentLimit, apiListLimit,
# concurrency, syncDaysBack, syncMaxPagesPerSubnet, maxAgeInDays, lms.httpTimeout, wazuh.oknoGodzin/minZdarzen/progHigh,
# revDns.cacheTtl, asn pluginów) są edytowalne w WWW. Sekrety/hosty/TLS/ścieżki — tylko .env.
#--------------------------------------------------------------------
# ASN globalny: „nasze IP” w UI i domyślny ASN dla cloudflare_botnet/qrator/spoofer (gdy ich asn puste)
# mcs.as198050.asn = 198050
# Kolejka dnia: okno w dniach (1,2,7,14,30,90) i minimalna waga (low|medium|high|critical)
# mcs.kolejkaDnia.oknoDni = 2
# mcs.kolejkaDnia.minWaga = high
# Problematyczne IP: długość mini-osi czasu (dni)
# mcs.problemyIp.oknoTimelineDni = 14
# API badge: max liczba IP w jednym żądaniu batch
# mcs.badge.maxIpsBatch = 100
# Dashboard speedtest: domyślne progi i top N
# mcs.speedtest.minDownloadMbps = 500
# mcs.speedtest.minUploadMbps = 500
# mcs.speedtest.topN = 20
# LMS sync: rozmiar strony i max stron
# mcs.lms.syncPageSize = 2000
# mcs.lms.syncMaxPages = 100
# Play: adres nadawcy alertów DDoS (domena służy też do dopasowania nadawcy)
# mcs.play.fromAddress = 'antyddos@play.pl'
# CAIDA Spoofer: max stron API
# mcs.spoofer.maxPages = 50
# Wazuh: timeout eksportu SSH i ConnectTimeout (s)
# mcs.wazuh.timeout = 60
# mcs.wazuh.connectTimeout = 10
# Timeouty HTTP (s): httpTimeout = cały request, httpConnectTimeout = nawiązanie połączenia
# mcs.abuseipdb.httpTimeout = 30
# mcs.ismalicious.httpTimeout = 30
# mcs.speedtest.httpTimeout = 120
# mcs.speedtest.httpConnectTimeout = 15
# mcs.snds.httpTimeout = 60
# mcs.snds.httpConnectTimeout = 15
# mcs.mojecert.httpTimeout = 60
# mcs.mojecert.httpConnectTimeout = 15
# mcs.cert_n6.httpTimeout = 120
# mcs.cert_n6.httpConnectTimeout = 30
# mcs.wanguard.httpTimeout = 60
# mcs.wanguard.httpConnectTimeout = 10
# mcs.cloudflare_botnet.httpTimeout = 60
# mcs.cloudflare_botnet.httpConnectTimeout = 10
# mcs.qrator.httpTimeout = 60
# mcs.qrator.httpConnectTimeout = 10
# mcs.spoofer.httpTimeout = 60
# mcs.spoofer.httpConnectTimeout = 10
