CI_ENVIRONMENT = production
app.baseURL = 'http://192.0.2.110/'
database.default.hostname = 127.0.0.1
database.default.database = mcs
database.default.username = mcs
database.default.password = 'ZMIEN'
database.default.DBDriver = Postgre
database.default.DBPrefix = ''
database.default.port = 5432
database.default.schema = public
database.default.charset = utf8
# MCS - API badge (LMS->MCS)
mcs.badgeToken = 'ZMIEN_TOKEN'

# --- Faza 1b: IMAP / SNDS per zrodlo (osobne konta; nie commituj prawdziwych hasel) ---
# Wymaga IMAP: apt install php8.4-imap (Sury na Trixie) + restart php-fpm/cli
# Patrz: docs/09-imap-konfiguracja-env.md

# Shadowserver (oficjalnie: imap.alfa-system.pl:993 SSL/TLS — poczta.alfa-system.pl/konfiguracja.html)
mcs.shadowserver.imapHost = ''
mcs.shadowserver.imapPort = 993
mcs.shadowserver.imapUser = ''
mcs.shadowserver.imapPass = ''
mcs.shadowserver.imapMailbox = 'INBOX'
mcs.shadowserver.imapEncryption = 'ssl'
# Gdy INBOX caly SEEN: ile ostatnich UID przetworzyc (checksum chroni przed duplikatem)
mcs.shadowserver.imapRecentLimit = 40
# Dev/smoke bez IMAP: ustaw sciezke CSV. Live IMAP: zostaw puste (albo usun linie).
mcs.shadowserver.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/shadowserver_sample.csv'

# Play scrubbing (OSOBNA skrzynka)
mcs.play.imapHost = ''
mcs.play.imapPort = 993
mcs.play.imapUser = ''
mcs.play.imapPass = ''
mcs.play.imapMailbox = 'INBOX'
mcs.play.imapEncryption = 'ssl'
mcs.play.imapRecentLimit = 100
mcs.play.fixturePath = ''

# SNDS - Microsoft Automated Data Access (jak LMS snds.key). Bez IMAP.
# key: UUID z portalu Auto (wygasa ~30 dni). lookbackDays: domyslnie 3 (wczoraj..).
mcs.snds.key = ''
mcs.snds.dataUrlTemplate = ''
# pusty template = substrate DataKey; useLegacyUrl=1 = stary host outlook
mcs.snds.useLegacyUrl = '0'
mcs.snds.lookbackDays = 3
# Dev/smoke: lokalny CSV (DataKey 13/14 kolumn lub z naglowkami). Live: zostaw puste.
mcs.snds.fixturePath = ''
# przyklad: '/var/www/mcs/tests/_support/fixtures/snds_datakey_sample.csv'
